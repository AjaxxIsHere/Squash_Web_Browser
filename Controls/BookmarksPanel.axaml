<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Squash_Web_Browser.Controls.BookmarksPanel">
  <DockPanel>
    <!-- Add Bookmark Section -->
    <StackPanel Orientation="Vertical">
      <StackPanel Orientation="Horizontal" Margin="8,0,8,8" Spacing="4">
        <TextBox x:Name="NameTextBox" Width="120" Height="30" Watermark="Name (placeholder)" />
        <TextBox x:Name="UrlTextBox" Width="200" Height="30" Watermark="URL (placeholder)" />
        <Button x:Name="AddBookmarkButton" Content="Add" Width="60" />
      </StackPanel>
       <TextBlock Text="(Click a bookmark name to open it - placeholder)" FontStyle="Italic" Margin="8,4,8,0" FontSize="11" />

       <ListBox Name="BookmarksList" Margin="8" SelectionMode="Single">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="[Name] (placeholder)" Width="120" VerticalAlignment="Center" />
            <TextBlock Text="[URL] (placeholder)" Width="200" VerticalAlignment="Center" />
            <Button Content="Edit" Width="50" />
            <Button Content="Delete" Width="60" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    </StackPanel>
   
  </DockPanel>
</UserControl>