<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Squash_Web_Browser.Models"
             xmlns:vm="clr-namespace:Squash_Web_Browser.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             x:Class="Squash_Web_Browser.Controls.BookmarksPanel">
  <DockPanel>
    <!-- Add Bookmark Section -->
    <StackPanel Orientation="Vertical">
      <StackPanel Orientation="Horizontal" Margin="8,0,8,8" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <TextBox Width="80" Height="30" Watermark="Name"
                 Text="{Binding BookmarkPanelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBox Width="200" Height="30" Watermark="URL"
                 Text="{Binding BookmarkPanelUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Button Content="Add" Width="60" Command="{Binding BookmarkPanelAddCommand}" />
      </StackPanel>
       <TextBlock Text="(Click a bookmark name to open it)" FontStyle="Italic" Margin="8,4,8,0" FontSize="11" />

       <ListBox Name="BookmarksList" ItemsSource="{Binding Bookmarks}" Margin="8" SelectionMode="Single">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="models:Bookmark">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="{Binding Name}" Width="80" HorizontalAlignment="Left" Padding="0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Command="{Binding #BookmarksList.DataContext.BookmarkPanelOpenCommand}"
                    CommandParameter="{Binding}" />
            <TextBlock Text="{Binding Url}" Width="180" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Content="Edit ✏️" Width="60"
                    Command="{Binding #BookmarksList.DataContext.BookmarkPanelEditCommand}"
                    CommandParameter="{Binding}" />
            <Button Content="Delete 🗑️" Width="60"
                    Command="{Binding #BookmarksList.DataContext.BookmarkPanelDeleteCommand}"
                    CommandParameter="{Binding}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    </StackPanel>
   
  </DockPanel>
</UserControl>